[Unit]
Description=CinePI Camera
After=graphical.target

[Service]
Type=simple
User=pi
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=QT_QPA_PLATFORM=wayland
Environment=WAYLAND_DISPLAY=wayland-0
Environment=QT_WAYLAND_DISABLE_WINDOWDECORATION=1
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=CINEPI_SKIP_SOUND=1
Environment=CINEPI_CONFIG_DIR=/home/pi/kurokesu-cinepi/config
Environment=LIBCAMERA_LOG_LEVELS=RPiAgc:ERROR,RPiCcm:ERROR
ExecStartPre=/bin/bash -c 'until [ -S /run/user/1000/wayland-0 ]; do sleep 1; done'
ExecStart=/home/pi/kurokesu-cinepi/build/release/cinepi
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
