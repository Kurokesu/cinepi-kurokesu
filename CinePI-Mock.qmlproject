import QmlProject 1.3

Project {
    mainFile: "qml/mock/MockMain.qml"
    qt6Project: true

    QmlFiles {
        files: [
            "qml/mock/MockMain.qml",
            "qml/components/CameraControls.qml",
            "qml/components/CameraPresets.qml",
            "qml/components/ControlButton.qml",
            "qml/components/GridOverlays.qml",
            "qml/components/MainLayout.qml",
            "qml/components/PopupGridItem.qml",
            "qml/components/SectionHeader.qml",
            "qml/components/SettingToggle.qml",
            "qml/components/SettingsPanel.qml",
            "qml/components/StatusBar.qml",
            "qml/components/StatusItem.qml",
            "qml/components/Theme.qml"
        ]
    }

    Files {
        filter: "*.conf"
        files: ["qtquickcontrols2.conf"]
    }

    Files {
        filter: "qmldir"
        files: ["qml/components/qmldir"]
    }

    Environment {
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
        QT_AUTO_SCREEN_SCALE_FACTOR: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
    }

    importPaths: ["qml/components"]
}
